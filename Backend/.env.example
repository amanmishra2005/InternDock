NODE_ENV=production
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/internship_platform
MONGO_MAX_POOL_SIZE=20
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://www.interndock.in,https://interndock.in
TRUST_PROXY=1
ADMIN_NAME="Program Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="InternDock <support.interndock@gmail.com>"
REPLY_TO=support@interndock.in
SUPPORT_EMAIL="support@interndock.in, support.interndock@gmail.com"
NOTIFICATION_EMAIL="support@interndock.in, support.interndock@gmail.com"
# Optional HTTP-based email delivery (Bypasses cloud host SMTP port blocks)
RESEND_API_KEY=
# RESEND_FROM: Defaults to "InternDock <onboarding@resend.dev>" if domain unverified. Set to "InternDock <support@interndock.in>" after verifying domain at resend.com/domains
RESEND_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support.interndock@gmail.com

ORG_NAME="InternDock"
ORG_SIGNATORY="Program Director"

GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_TOKEN=
GOOGLE_SHEET_SYNC_TIMEOUT_MS=10000
