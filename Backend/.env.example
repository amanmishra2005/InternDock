NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/internship_platform
MONGO_MAX_POOL_SIZE=40
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins. Use HTTPS origins in production.
CLIENT_URL=http://localhost:5173
# Set to 1 when deployed behind a reverse proxy such as Nginx, Render, or Railway.
TRUST_PROXY=0
ADMIN_NAME="Program Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# Email (optional — leave blank to just log emails to the console)
SMTP_HOST=
SMTP_PORT=587
# Use `true` for port 465; use `false` with STARTTLS for port 587.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Internship Platform <no-reply@example.com>"

ORG_NAME="Your Organization Pvt Ltd"
ORG_SIGNATORY="Program Director"

# Optional Google Apps Script webhook for copying CSV events into Google Sheets.
# Local CSV backups remain available under Backend/uploads/spreadsheet_ledger.
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_TOKEN=
GOOGLE_SHEET_SYNC_TIMEOUT_MS=10000
