NODE_ENV=production
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/internship_platform
MONGO_MAX_POOL_SIZE=20
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,https://www.interndock.in,https://interndock.in
TRUST_PROXY=1
ADMIN_NAME="Program Admin"
ADMIN_EMAIL=support.interndock@gmail.com
ADMIN_PASSWORD=change_this_to_a_strong_admin_password

# ==============================================================================
# SMTP EMAIL SERVICE CONFIGURATION (REQUIRED FOR EMAIL WORKFLOWS)
# When deploying to Render/Railway/Fly/EC2, ensure all SMTP_* variables below are
# added to the environment settings of the deployed backend service.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
SMTP_USER=support.interndock@gmail.com
# For Gmail: Use a 16-character Google App Password (not your account password)
# Generated under Google Account > Security > 2-Step Verification > App Passwords
SMTP_PASS=your_16_character_google_app_password

# Email Headers & Inboxes
EMAIL_FROM="InternDock <support.interndock@gmail.com>"
REPLY_TO=support.interndock@gmail.com
SUPPORT_EMAIL=support.interndock@gmail.com
NOTIFICATION_EMAIL=support.interndock@gmail.com

# Optional Secondary HTTP Fallback Provider (Used only if SMTP ports are blocked)
RESEND_API_KEY=
# RESEND_FROM: Defaults to "InternDock <onboarding@resend.dev>" if domain unverified.
# Set to "InternDock <support.interndock@gmail.com>" after verifying domain at resend.com/domains
RESEND_FROM=

# ==============================================================================
# ANTI-BOT & CAPTCHA (100% FREE CLOUDFLARE TURNSTILE)
# Create free sitekey & secret at https://dash.cloudflare.com/?to=/:account/turnstile
# If unset, the backend applies honeypot traps and submission timing heuristics.
# ==============================================================================
CLOUDFLARE_TURNSTILE_SECRET_KEY=

ORG_NAME="InternDock"
ORG_SIGNATORY="Program Director"

# Google Sheets Ledger Sync (Optional)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_TOKEN=
GOOGLE_SHEET_SYNC_TIMEOUT_MS=10000
