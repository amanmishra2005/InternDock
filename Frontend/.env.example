# Public API base URL. Values prefixed with VITE_ are included in the browser build.
# For a same-domain deployment behind a reverse proxy, keep this as /api.
VITE_API_URL=/api

# 100% Free Cloudflare Turnstile Managed Anti-Bot Challenge Site Key
# Obtain from https://dash.cloudflare.com/?to=/:account/turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
